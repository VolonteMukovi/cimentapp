# ========================
# DJANGO
# ========================
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost,cimentapp.uhakikaapp.store

# Production HTTPS (derriere reverse proxy)
TRUST_PROXY=True
# Optionnel si ALLOWED_HOSTS ne suffit pas :
# CSRF_TRUSTED_ORIGINS=https://cimentapp.uhakikaapp.store

# Coolify / VPS :
# Monter un volume persistant sur /cimentapp/media
# sinon les images uploadées disparaissent a chaque redeploy.
#
# Gunicorn (image Docker). Deux workers gthread : un upload lent ne tue
# plus le processus au bout de 30 s, et la RAM reste plus basse qu'avec
# 3 workers sync.
# WEB_CONCURRENCY=2
# WEB_THREADS=4
# GUNICORN_TIMEOUT=120
# MAX_UPLOAD_MB=20

# ========================
# DATABASE (MySQL) - depuis Django (dans Docker)
# ========================
DB_NAME=cimentdb
DB_USER=cimentuser
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306

# ========================
# MYSQL ROOT (utilisé par le conteneur MySQL)
# ========================
MYSQL_ROOT_PASSWORD=change-me

